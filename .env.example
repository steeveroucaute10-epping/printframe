# Environment Variables
# Copy this file to .env.local and fill in the values

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/printframe?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Stripe
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# Auth (NextAuth)
NEXTAUTH_SECRET="replace_with_long_random_string"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_replace_me"

# File Storage (Cloudflare R2)
AWS_ACCESS_KEY_ID="replace_me"
AWS_SECRET_ACCESS_KEY="replace_me"
R2_BUCKET="printframe-uploads"
R2_ENDPOINT="https://account-id.r2.cloudflarestorage.com"

# Ollama (Local LLM)
OLLAMA_BASE_URL="http://localhost:11434"

# Google Maps (for address autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="replace_me"

# Sentry (error tracking)
SENTRY_DSN="replace_me"
